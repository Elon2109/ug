close all; clear all;

n=input('Enter the number of data points n: ');

for i = 1:n
x(i)= input('Enter x: ');
end

for i = 1:n
y(i) = input('Enter y: ');
end

yp = input('Enter the value of y to find x: ');

xp = 0;

for i = 1:n
p = 1;

for j = 1:n
if i ~= j
p = p * (yp - y(j))/(y(i) - y(j));
end
end

xp = xp + p * x(i);
end

fprintf('\nInterpolated value of x = %.4f\n', xp);



