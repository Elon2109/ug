Div: TYME(A)

clc;
close all;
clear all;

n = input('Enter the number of data points n: ');
for i = 1:n
    x(i) = input('Enter x: ');
end
for i = 1:n
    y(i) = input('Enter y: ');
end

xp = input('Enter the value of x to find y: ');
h = x(2) - x(1);
u = (xp - x(1))/h;

d = zeros(n,n);
d(:,1) = y(:);
for j = 2:n
    for i = 1:n-j+1
        d(i,j) = d(i+1,j-1) - d(i,j-1);
    end
end

yp = d(1,1);
term = 1;
for j = 1:n-1
    term = term * (u-(j-1))/j;
    yp = yp + term*d(1,j+1);
end

fprintf('\nInterpolated value of y = %.4f\n',yp);

% Solver
p = polyfit(x,y,n-1);
ys = polyval(p,45)


