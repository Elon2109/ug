sumlogy = 0;
sumlogx2 = 0;
sumlogxy = 0; for i = 1:n
sumlogx = sumlogx + log(x(i)); sumlogy = sumlogy + log(y(i));
sumlogx2 = sumlogx2 + log(x(i))*log(x(i)); sumlogxy = sumlogxy + log(x(i))*log(y(i));
end
A = [n, sumlogx; sumlogx, sumlogx2];
B = [sumlogy; sumlogxy];
C = inv(A)*B;
a = exp(C(1));
b = C(2);
fprintf('a = %.4f\n', a);
